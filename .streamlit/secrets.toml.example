# Streamlit Cloud: Manage app → Secrets 에 아래 블록 전체를 붙여넣기
# 로컬: 이 파일을 secrets.toml 로 복사한 뒤 url/key 를 채운다.
#
# Supabase Dashboard → Project Settings → API
#   - Project URL  → url
#   - anon public  → key  (service_role 키 아님)
# 프로젝트가 Paused(일시중지)면 Restore project 후 사용

[supabase]
url = "https://YOUR_PROJECT_REF.supabase.co"
key = "YOUR_ANON_PUBLIC_KEY"
